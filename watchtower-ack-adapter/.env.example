# Character Kit facing
# Path to the root/user-owned enforcement socket the daemon listens on.
CHARACTER_KIT_SOCKET=/run/ack/enforcer.sock
# Optional: when talking to the Python EnforcerClient directly.
CHARACTER_KIT_SOCKET_PATH=

# Watchtower facing (machine ingress)
WATCHTOWER_GATEWAY=https://fapi.drdeeks.xyz
WATCHTOWER_INGESTION_SECRET=
WATCHTOWER_PRODUCER=bridge-character-kit

# Bridge identity
BRIDGE_PROJECT_ID=
BRIDGE_AGENT_ID=

# Delivery hardening
BRIDGE_MAX_RETRIES=5
BRIDGE_RETRY_BASE_MS=200
