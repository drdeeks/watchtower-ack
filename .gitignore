# ============================================================
# FEDERATION ADAPTERS — monorepo .gitignore
# Applies to every package under this repo (watchtower-ack-adapter/ and
# any future adapters) via patterns that match at any depth.
# ============================================================

# ============================================================
# DEPENDENCIES
# ============================================================
**/node_modules/
.pnp.*
.pnp.js
**/.yarn/
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.npmrc
.yarnrc
**/.pnpm-store/

# ============================================================
# SECRETS & LOCAL CONFIG (CRITICAL — never commit real secrets)
# ============================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.local
.dev.vars
.dev.vars.*
!.dev.vars.example

# ============================================================
# BUILD, TEST & RUNTIME OUTPUT
# ============================================================
**/dist/
**/build/
**/out/
*.tsbuildinfo
*.tsbuildinfo.*
tsconfig.tsbuildinfo

# Test / coverage artifacts
**/coverage/
.nyc_output/
*.lcov
**/test-results/
**/playwright-report/

# Cache directories
.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache

# Logs
*.log
logs/
*.pid
*.pid.lock
*.seed

# Local dev scratch (trash > purge; keep recoverable)
**/.scratch/
**/.tmp/
**/tmp/
**/temp/

# ============================================================
# PYTHON (some adapters/skills may ship Python helpers)
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# ============================================================
# OPERATING SYSTEM FILES
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.nfs*

# ============================================================
# EDITOR & IDE FILES
# ============================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.vscode-test/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*.swn
*.bak
*.un~
Session.vim
.netrwhist
.sublime-project
.sublime-workspace

# ============================================================
# AI ASSISTANT FILES (local development only, never commit)
# ============================================================
.agents/
.claude/
.codex/
.cursor/
.cursorrules

# ============================================================
# RELEASE & PACKAGING
# ============================================================
*.tgz
*.tar.gz
*.npm
dist-*/
release-*/

# ============================================================
# SECURITY & VULNERABILITY SCANS
# ============================================================
.socket/
*.socket
.snyk
npm-audit.json

# ============================================================
# MISCELLANEOUS
# ============================================================
*.patch
*.diff
*.backup
*.old
